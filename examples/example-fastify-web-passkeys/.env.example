AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SESSION_SECRET=

# Passkeys are bound to your custom domain, so the page must be served over HTTPS from a subdomain of it.
# For example https://app.login.example.com when the custom domain is login.example.com. See the README.
APP_BASE_URL=

# The database connection that has the Passkey authentication method turned on.
# Leave it empty to use the tenant's Default Directory.
AUTH0_CONNECTION=

# The IP addresses (or CIDR ranges) of the reverse proxies in front of the app, comma separated, for example 127.0.0.1
# or 10.0.0.0/8, so that the user's IP address (from X-Forwarded-For) is what Auth0 receives and what the rate limit
# counts, not the proxy's. Leave it false when the app is reachable directly. Do not use true or a number: true would let
# a client choose its own IP address, and current Fastify versions ignore a number.
TRUST_PROXY=false

# The port the app listens on.
PORT=3000
