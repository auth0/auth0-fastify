AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SESSION_SECRET=

# Passkeys are bound to your custom domain, so the page must be served over HTTPS from a subdomain of it.
# For example https://app.login.example.com when the custom domain is login.example.com. See the README.
APP_BASE_URL=

# The database connection that has the Passkey authentication method turned on.
# Leave it empty to use the tenant's Default Directory.
AUTH0_CONNECTION=

# The number of reverse proxies in front of the app, for example 1, so that the user's IP address (from X-Forwarded-For)
# is what Auth0 receives and what the rate limit counts, not the proxy's. Leave it false when the app is reachable
# directly. Do not use true: it would let a client choose its own IP address.
TRUST_PROXY=false

# The port the app listens on.
PORT=3000
